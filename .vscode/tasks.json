{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv debug main_stock",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": [
        "-m",
        "debugpy",
        "--listen",
        "5678",
        "--wait-for-client",
        "-m",
        "src.main_stock"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "env": {
        "QT_QPA_PLATFORM_PLUGIN_PATH": "${workspaceFolder}\\.venv\\Lib\\site-packages\\PyQt5\\Qt5\\plugins\\platforms"
      },
      "problemMatcher": {
        "pattern": [
          {
            "regexp": ".",
            "file": 1,
            "location": 1,
            "message": 1
          }
        ],
        "background": {
          "beginsPattern": ".*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "new"
      }
    }
  ]
}
