{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: main_stock.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/main_stock.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: ui2py.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/UI/ui2py.py",
      "cwd": "${workspaceFolder}/UI",
      "console": "integratedTerminal"
    },
    {
      "name": "PowerShell: docker-compose up -d",
      "type": "PowerShell",
      "request": "launch",
      "script": "docker-compose up -d",
      "cwd": "${workspaceFolder}"
    }
  ]
}
