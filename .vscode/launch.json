{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UV: Debug main_stock.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main_stock.py",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "preLaunchTask": "uv sync"
    },
    {
      "name": "UV: Debug ui2py.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/UI/ui2py.py",
      "cwd": "${workspaceFolder}/UI",
      "console": "integratedTerminal",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "preLaunchTask": "uv sync"
    },
    {
      "name": "UV: Debug migration quarterly_reports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "preLaunchTask": "uv sync",
      "args": [
        "--type",
        "quarterly_reports",
        "--start-year",
        "2025",
        "--end-year",
        "2025"
      ]
    },
    {
      "name": "UV: Debug migration monthly_reports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "preLaunchTask": "uv sync",
      "args": [
        "--type",
        "monthly_reports",
        "--start-year",
        "2024",
        "--end-year",
        "2025"
      ]
    },
    {
      "name": "UV: Debug migration dividend_yield",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "preLaunchTask": "uv sync",
      "args": [
        "--type",
        "dividend_yield",
        "--start-date",
        "2024-01-01",
        "--end-date",
        "2026-03-22"
      ]
    }
  ]
}
