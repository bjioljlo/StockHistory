{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: main_stock.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/src/main_stock.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: ui2py.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/UI/ui2py.py",
      "cwd": "${workspaceFolder}/UI",
      "console": "integratedTerminal"
    },
    {
      "name": "PowerShell: docker-compose",
      "type": "PowerShell",
      "request": "launch",
      "script": "docker-compose up --build",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Python: migration season reports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--type",
        "quarterly_reports",
        "--start-year",
        "2010",
        "--end-year",
        "2024"
      ]
    },
    {
      "name": "Python: migration month reports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--type",
        "monthly_reports",
        "--start-year",
        "2024",
        "--end-year",
        "2025"
      ]
    },
    {
      "name": "Python: migration dividend_yield reports",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceRoot}/scripts/migration/migrate_reports_data.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--type",
        "dividend_yield",
        "--start-date",
        "2024-01-01",
        "--end-date",
        "2026-01-01"
      ]
    }
  ]
}
