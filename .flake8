[flake8]
max-line-length = 120
extend-ignore = E203, W503, E731
exclude =
    .git,
    __pycache__,
    *.pyc,
    *.pyo,
    *.egg-info,
    venv,
    env,
    build,
    dist,
    migrations,
    tests/data
per-file-ignores =
    __init__.py: F401
max-complexity = 10
docstring-convention = pep257